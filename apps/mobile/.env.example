# Copy to .env.local and fill in. Only PUBLIC values go here: EXPO_PUBLIC_* is bundled into the app.
# Never add a Supabase secret key, a service role key, or any API key (Spoonacular, Groq).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to 1 once the Apple Developer account and the Supabase Apple provider are set up.
# Shows "Continue with Apple" on iOS devices that support it. Leave empty until then.
EXPO_PUBLIC_APPLE_SIGN_IN=
# The web app's origin, for the server routes the app calls (account deletion, pushes).
# Defaults to the live site when empty.
EXPO_PUBLIC_API_URL=
