# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys (both are safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secrets — used from Phase 2 on. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SPOONACULAR_API_KEY=
