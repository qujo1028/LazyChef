# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys (both are safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secrets — used from Phase 2 on. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional. Without it, new pantry items are matched against the built-in ingredient library only.
SPOONACULAR_API_KEY=
# Optional. Free Groq key (no card) from https://console.groq.com/keys for LLM features. Server-only.
GROQ_API_KEY=
# Only for `npm run recipes:import` (not the app). "1" is TheMealDB's test key, for development only;
# a public app needs a supporter key from https://www.themealdb.com/api.php. Server-only.
THEMEALDB_API_KEY=

# Pro subscriptions (RevenueCat). See "Pro subscriptions" in the README.
# Server-only: RevenueCat → Project settings → API keys → secret key (sk_...). Lets the server
# read each customer's subscription after a webhook or a purchase.
REVENUECAT_SECRET_API_KEY=
# Server-only: any long random string, e.g. "Bearer <openssl rand -hex 32>". Paste the exact same
# value into RevenueCat → Integrations → Webhooks → Authorization header value.
REVENUECAT_WEBHOOK_AUTH=
# Public SDK keys for the apps (safe in the browser): RevenueCat → API keys → the App Store app's
# key (appl_...) and the Play Store app's key (goog_...). Set them in Vercel too: the apps load the live site.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=

# Optional. Public URL for auth email links when a request has no Origin/Host header,
# e.g. https://lazychef-gamma.vercel.app. Leave empty for local development.
NEXT_PUBLIC_SITE_URL=

# Public support address shown on /privacy, /terms and /support (e.g. support@yourdomain).
# Leave empty until it exists; the pages then say a contact address is on its way.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Admin dashboard (/admin). Server-only.
# Comma-separated sign-in emails allowed in (case-insensitive). Empty means nobody: /admin is a 404.
ADMIN_EMAILS=
# Read-only fine-grained GitHub token (Issues + Pull requests: read) for the admin board.
GITHUB_DASHBOARD_TOKEN=
# The repo the board reads, as owner/name, e.g. qujo1028/LazyChef.
GITHUB_REPO=
