# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys (both are safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secrets — used from Phase 2 on. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional. Without it, new pantry items are matched against the built-in ingredient library only.
SPOONACULAR_API_KEY=
# Optional. Free Groq key (no card) from https://console.groq.com/keys for LLM features. Server-only.
GROQ_API_KEY=
# Only for `npm run recipes:import` (not the app). "1" is TheMealDB's test key, for development only;
# a public app needs a supporter key from https://www.themealdb.com/api.php. Server-only.
THEMEALDB_API_KEY=

# Optional. Public URL for auth email links when a request has no Origin/Host header,
# e.g. https://lazychef-gamma.vercel.app. Leave empty for local development.
NEXT_PUBLIC_SITE_URL=
